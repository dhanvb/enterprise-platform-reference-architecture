{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/enterprise-platform/contracts/delivery/v1/promotion-request.schema.json",
  "title": "A05 PromotionRequest v1 (not authorization)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "requestId", "releaseId", "applicationId", "targetEnvironment", "artifactDigest", "configurationRevision", "onboarding", "policyVersion", "requesterId", "changeRef", "requestedAt"],
  "properties": {
    "apiVersion": {"const": "platform.example.org/v1"},
    "kind": {"const": "PromotionRequest"},
    "requestId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "releaseId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "applicationId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$"},
    "targetEnvironment": {"enum": ["development", "staging", "production"]},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "configurationRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "onboarding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "policyVersion": {"const": "a05-demo-v1"},
    "requesterId": {"type": "string", "minLength": 3, "maxLength": 128},
    "changeRef": {"type": "string", "minLength": 3, "maxLength": 128},
    "requestedAt": {"type": "string", "format": "date-time"}
  }
}
